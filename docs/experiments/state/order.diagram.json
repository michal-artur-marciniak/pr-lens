{"schemaVersion":"0.4.0","kind":"diagram","title":"Order lifecycle","summary":"Payment, fulfillment, cancellation and refund as explicit state transitions.","diagram":{"kind":"state","states":[{"id":"start","kind":"initial","label":"Start"},{"id":"created","label":"Created"},{"id":"paid","label":"Paid"},{"id":"shipped","label":"Shipped"},{"id":"cancelled","label":"Cancelled"},{"id":"refunded","label":"Refunded","delta":"added"},{"id":"done","kind":"final","label":"Closed"}],"transitions":[{"id":"create","from":"start","to":"created","label":"Create"},{"id":"pay","from":"created","to":"paid","label":"Pay","guard":"approved"},{"id":"ship","from":"paid","to":"shipped","label":"Ship"},{"id":"cancel","from":"created","to":"cancelled","label":"Cancel"},{"id":"refund","from":"shipped","to":"refunded","label":"Refund","guard":"accepted","delta":"added"},{"id":"close-shipped","from":"shipped","to":"done","label":"Close"},{"id":"close-cancelled","from":"cancelled","to":"done","label":"Close"},{"id":"close-refunded","from":"refunded","to":"done","label":"Close","delta":"added"}],"scenarios":[{"id":"fulfill","label":"Payment and shipment","path":["create","pay","ship","close-shipped"]},{"id":"cancel-order","label":"Cancel before payment","path":["create","cancel","close-cancelled"]},{"id":"return-order","label":"Refund after shipment","path":["create","pay","ship","refund","close-refunded"]}]}}
